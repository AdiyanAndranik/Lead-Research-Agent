# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lead_agent
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/lead_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq (get free API key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Serper (get free API key at serper.dev - 100 free searches)
SERPER_API_KEY=your_serper_api_key_here

# LangSmith (get free API key at smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=lead-research-agent

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Pipeline defaults
DEFAULT_MIN_SCORE_THRESHOLD=6
DEFAULT_EMAIL_TONE=conversational
DEFAULT_EMAIL_ANGLE=pain